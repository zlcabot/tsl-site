# Copy to .env (gitignored). Values live in 1Password; reference them
# with op:// URIs and run deploys via:
#   op run --env-file=.env -- ./scripts/deploy.sh
NETLIFY_AUTH_TOKEN="op://Private/Netlify TSL deploy token/credential"
NETLIFY_SITE_ID="<project id from Netlify: Project configuration -> General -> Project details>"
